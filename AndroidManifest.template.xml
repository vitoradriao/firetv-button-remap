<?xml version="1.0" encoding="utf-8"?>
<!-- @RULES@ = "text in the button's log line>package to open;..." -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="tv.redirect" android:versionCode="2" android:versionName="2.0">
    <uses-sdk android:minSdkVersion="22" android:targetSdkVersion="30" />
    <uses-permission android:name="android.permission.READ_LOGS" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application android:label="Botoes do controle" android:allowBackup="false">
        <meta-data android:name="rules" android:value="@RULES@" />
        <service android:name="tv.redirect.ButtonService" android:exported="true"
            android:label="Botoes do controle"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
        </service>
    </application>
</manifest>
